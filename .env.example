# Endereco do RabbitMQ usado pelo gateway e pelos workers.
# Define o exemplo de RABBITMQ_HOST; copie para .env para o Compose utilizar a configuração.
RABBITMQ_HOST=localhost
# Porta TCP em que o gateway recebe os clientes.
# Define o exemplo de GATEWAY_PORT; copie para .env para o Compose utilizar a configuração.
GATEWAY_PORT=5000
# Porta exposta no computador para clientes e para o script de demonstracao.
# Define o exemplo de GATEWAY_HOST_PORT; copie para .env para o Compose utilizar a configuração.
GATEWAY_HOST_PORT=15000
# Porta da tela web do RabbitMQ no computador.
# Define o exemplo de RABBITMQ_UI_HOST_PORT; copie para .env para o Compose utilizar a configuração.
RABBITMQ_UI_HOST_PORT=15673
# Pasta em que o worker lider grava os dois bancos SQLite.
# Define o exemplo de DATA_DIR; copie para .env para o Compose utilizar a configuração.
DATA_DIR=./data
